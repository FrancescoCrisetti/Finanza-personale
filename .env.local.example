# Opzionale: se impostata, limita il login alla sola email indicata
ALLOWED_EMAIL=

# Opzionale: segreto per autenticare la chiamata del cron giornaliero di
# Vercel a /api/v1/cron/snapshot-networth (Vercel la invia come
# "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
